{
  "name": "consumer-rights-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified Consumer Grievance and Rights Protection Portal for the Addis Ababa Bureau of Trade and Market Development",
  "workspaces": [
    "lib/*",
    "backend",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@consumer-rights/web",
    "backend:dev": "npm run start:dev --workspace=@consumer-rights/backend",
    "backend:build": "npm run build --workspace=@consumer-rights/backend",
    "prisma:generate": "npm run prisma:generate --workspace=@consumer-rights/backend",
    "validate": "node scripts/validate.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/better-auth.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run validate && npm run backend:build && npm run test && npm run typecheck && npm run build",
    "test:browser": "node tests/browser/auth.mjs && node tests/browser/public-site.mjs && node tests/browser/portals.mjs && node tests/browser/portals-menu.mjs && node tests/browser/admin.mjs",
    "test:browser:portals": "node tests/browser/portals.mjs",
    "test:browser:menu": "node tests/browser/portals-menu.mjs",
    "test:browser:admin": "node tests/browser/admin.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node backend/prisma/seed.mjs",
    "dev:otp": "node backend/scripts/dev-otp.mjs",
    "dev:api": "node --env-file=.env backend/dist/main.js",
    "test:browser:data": "node tests/browser/data.mjs",
    "test:browser:chat": "node tests/browser/chat.mjs",
    "test:browser:evidence": "node tests/browser/evidence.mjs",
    "test:browser:auth": "node tests/browser/auth.mjs"
  }
}
