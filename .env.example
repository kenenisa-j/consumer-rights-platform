# Copy to `.env` and replace every REPLACE_* value. `.env` is never committed.
# Ports differ from the AddisB2B repo (3100/4100/5544) so both can run on one machine.

PUBLIC_URL=http://localhost:3300
WEB_PORT=3300
WEB_HOST=127.0.0.1
API_PORT=4300
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4300

# PostgreSQL 16 (see compose.yaml: `docker compose up -d db`)
DB_PORT=5546
POSTGRES_USER=consumer_rights
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=consumer_rights
DATABASE_URL=postgresql://consumer_rights:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5546/consumer_rights

# Sessions and internal proxy signing: two different random values, 32+ characters each.
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_PROXY_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET

# Product settings (configurable values, never hard-coded in pages)
# Placeholder until the Bureau supplies the real toll-free number.
FREE_CALL_NUMBER=8070
DEFAULT_LOCALE=en

# Evidence uploads (receipts, photos). Default: .runtime/uploads
# UPLOAD_DIRECTORY=/var/lib/consumer-rights/uploads

# Email placeholders: not connected to delivery yet. Leave empty locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# First-run administrator. Used once; change the password in the app afterwards.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Development only. Never enable on a shared or live installation.
# DEV_OPEN_WORKSPACES=false
